<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_CALL_LOG"/>
    <application android:label="UenkerLabs Telefon" android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="false" android:allowBackup="false">
        <activity android:name=".PhoneActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <service android:name=".LocalScreeningService" android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter><action android:name="android.telecom.CallScreeningService"/></intent-filter>
        </service>
    </application>
</manifest>

